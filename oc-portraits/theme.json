{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "sage", "name": "Sage", "color": "#9EAF9B" },
				{ "slug": "forest", "name": "Deep forest", "color": "#263E34" },
				{ "slug": "pale-sage", "name": "Pale sage", "color": "#EFF3ED" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "rose", "name": "Dusty rose (accents only)", "color": "#C6A49D" },
				{ "slug": "moss", "name": "Moss (small text on light backgrounds)", "color": "#4F604D" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "0.875rem" },
				{ "slug": "30", "name": "M", "size": "1.25rem" },
				{ "slug": "40", "name": "L", "size": "clamp(1.5rem, 3vw, 2.25rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(2.75rem, 7vw, 5.5rem)" },
				{ "slug": "70", "name": "3XL", "size": "clamp(3.5rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Newsreader (headings)",
					"fontFamily": "Newsreader, 'Iowan Old Style', Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Figtree (body)",
					"fontFamily": "Figtree, 'Segoe UI', system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.875rem", "fluid": { "min": "2rem", "max": "2.875rem" } },
				{ "slug": "display", "name": "Display", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"custom": {
			"eyebrow-tracking": "0.22em"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--forest)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				},
				"color": { "text": "var(--wp--preset--color--forest)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--forest)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--forest)" },
				"spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "600",
					"letterSpacing": "0.18em",
					"textTransform": "uppercase",
					"lineHeight": "1.3"
				},
				":hover": {
					"color": { "background": "#1A2C24", "text": "var(--wp--preset--color--white)" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" },
				"color": { "text": "var(--wp--preset--color--moss)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.625rem",
					"fontWeight": "400",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.02em" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--rose)" },
				"border": { "width": "0" }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--moss)" }
			},
			"core/post-author-name": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "var(--wp--custom--eyebrow-tracking)",
					"textTransform": "uppercase",
					"fontWeight": "500"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--sage)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.5rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var(--wp--preset--color--sage)", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem" } }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (sections, no automatic title)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "inquiry-band", "title": "Inquiry band", "area": "uncategorized" }
	]
}
